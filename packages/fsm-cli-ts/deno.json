{
  "name": "@pgfsm/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.43.0",
    "@logtape/logtape": "npm:@logtape/logtape@^2.2",
    "@std/assert": "jsr:@std/assert@1",
