{
  "name": "@pgfsm/compiler",
  "version": "0.1.8",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "tasks": {
    "dev": "deno run --allow-all --watch src/cli/index.ts",
    "cli": "deno run --allow-all src/cli/index.ts",
    "test": "deno test --allow-all test/",
    "test:watch": "deno test --allow-all --watch test/",
    "build:npm": "deno run --allow-all scripts/build-npm.ts",
    "generate:templates": "deno run --allow-read --allow-write scripts/generate-eta-templates.ts"
  },
  "imports": {
    "@logtape/logtape": "npm:@logtape/logtape@^2.2",
    "@deno/dnt": "jsr:@deno/dnt@^0.43.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/path": "jsr:@std/path@1",
    "eta": "npm:eta@^3.5.0",
    "@types/pg": "npm:@types/pg@^8.18.0",
    "ajv": "npm:ajv@^8.18.0",
    "dotenv": "npm:dotenv@^16.5.0",
    "pg": "npm:pg@^8.20.0",
    "type-fest": "npm:type-fest@^4.41.0",
    "uuid": "npm:uuid@^11.1.0",
    "xstate": "npm:xstate@^5.19.4"
  }
}
