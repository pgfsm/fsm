    asyncOperationVersion: <%~ JSON.stringify(a.asyncOperationVersion) %>,
    asyncOperationLanguage: <%~ JSON.stringify(a.asyncOperationLanguage) %>,
<% if (a.declaresMaxConcurrency) { -%>
