  {
    fsmName: <%~ JSON.stringify(it.fsmName) %>,
    fsmVersion: <%~ JSON.stringify(it.fsmVersion) %>,
    syncOperationType: <%~ JSON.stringify(g.kind) %>,
    syncOperationName: <%~ JSON.stringify(e.name) %>,
    syncOperationLanguage: <%~ JSON.stringify(it.lang) %>,
    handler: <%~ e.importName %>,
  },
<% } -%>
<% } -%>
];
