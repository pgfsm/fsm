# AUTO-GENERATED by fsm-compiler-ts. Do not edit directly.
# Python worker for the Activity Gateway. The SDK itself lives in the
# published pgfsm-async-worker-sdk package; this directory only holds the
# actors, their compiler-generated registry and run_async_worker.py.
#
#   uv run run_async_worker.py list    # print the actors in the registry
#   uv run run_async_worker.py start   # connect to the gateway and serve
#
# Without uv: `python3 -m pip install "pgfsm-async-worker-sdk>=0.1.0,<0.2"`,
# then `python3 run_async_worker.py start`.
[project]
name = "pgfsm-async-worker-python"
version = "0.0.0"
requires-python = ">=3.10"
dependencies = [
  "pgfsm-async-worker-sdk>=0.1.0,<0.2",
]

[tool.uv]
# An app, not an installable package: uv only manages its environment.
package = false
