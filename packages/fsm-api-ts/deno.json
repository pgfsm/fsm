{
  "name": "@pgfsm/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./mod.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.43.0",
    "@hono/node-server": "npm:@hono/node-server@^1.14.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1",
    "@asteasolutions/zod-to-openapi": "npm:@asteasolutions/zod-to-openapi@^7.3.2",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@0.19.9",
    "@libsql/client": "npm:@libsql/client@^0.15.7",
    "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@^0.9.1",
    "@supabase/ssr": "npm:@supabase/ssr@^0.6.1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.49.8",
    "@types/pg": "npm:@types/pg@^8.18.0",
    "dotenv": "npm:dotenv@^16.5.0",
    "drizzle-kit": "npm:drizzle-kit@^0.31.9",
    "drizzle-orm": "npm:drizzle-orm@^0.45.1",
    "drizzle-zod": "npm:drizzle-zod@^0.8.3",
    "hono": "npm:hono@^4.13.20",
    "@logtape/hono": "npm:@logtape/hono@^2.2",
    "@logtape/logtape": "npm:@logtape/logtape@^2.2",
    "@logtape/otel": "npm:@logtape/otel@^2.2",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1",
    "hono-pino": "npm:hono-pino@^0.10.0",
    "json-diff-ts": "npm:json-diff-ts@^4.9.1",
    "pg": "npm:pg@^8.20.0",
    "pino": "npm:pino@^9.6.0",
    "pino-pretty": "npm:pino-pretty@^13.0.0",
    "type-fest": "npm:type-fest@^4.41.0",
    "uuid": "npm:uuid@^11.1.0",
    "xstate": "npm:xstate@^5.26.0",
    "stoker/": "./stoker-src/",
    "zod": "npm:zod@^3.25.30"
  },
  "tasks": {
    "start": "deno run --allow-all --env-file=./../../.env --watch=. deno.ts",
    "cli": "deno run --allow-all src/cli/index.ts",
    "build:npm": "deno run --allow-all scripts/build-npm.ts",
    "test": "deno test --allow-all test/"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "exclude": [
    "stoker-src/**/*.test.ts"
  ]
}
